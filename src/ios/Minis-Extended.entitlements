<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- ══════════ 应用身份（CloudKit 必需） ══════════ -->
	<key>application-identifier</key>
	<string>OPENMINIS01.com.openminis.app</string>
	<key>com.apple.developer.team-identifier</key>
	<string>OPENMINIS01</string>

	<!-- ══════════ TrollStore 全盘直通特权（保持沙盒） ══════════ -->
	<!--
	  特意【不】声明下面这三项：
	      com.apple.private.security.no-sandbox
	      com.apple.private.security.no-container
	      com.apple.private.security.container-required = false

	  原因（早期提交 b15488d847 已验证并留有记录）：
	  逃逸沙盒会让本 App 失去容器，于是 WKWebView 的 WebContent 子进程
	  拿不到「本 App 容器」的沙盒扩展，表现为内置浏览器任何页面都打不开
	  —— 本地文件同样经 WebContent 渲染，所以本地预览也一起失效。

	  读其它 App 容器、读写目标 App 目录，改用下面的沙盒例外实现：
	  它们在保持沙盒的前提下同样能枚举容器、读写任意绝对路径，
	  因此不再需要靠「逃逸沙盒」换取这些能力。
	-->
	<key>platform-application</key>
	<true/>
	<key>com.apple.private.security.storage-exempt.heritable</key>
	<true/>
	<key>com.apple.private.persona-mgmt</key>
	<true/>

	<!-- ══════════ 全盘绝对路径读写白名单（/ = 全系统） ══════════ -->
	<!-- 注入投递（写目标 App 的 Bundle container）、读其它 App 容器、
	     读越狱目录，都靠这一条在沙盒内完成，无需逃逸沙盒。 -->
	<key>com.apple.security.exception.files.absolute-path.read-write</key>
	<array>
		<string>/</string>
	</array>
	<key>com.apple.private.security.storage.AppBundles</key>
	<true/>
	<key>com.apple.private.security.storage.AppDataContainers</key>
	<true/>
	<key>com.apple.private.MobileContainerManager.allowed</key>
	<true/>
	<key>com.apple.private.security.container-manager</key>
	<true/>

	<!-- ══════════ Relaxin / Dopamine / 系统内核调试与注入特权 ══════════ -->
	<key>get-task-allow</key>
	<true/>
	<key>task_for_pid-allow</key>
	<true/>
	<key>run-unsigned-code</key>
	<true/>
	<key>proc_info-allow</key>
	<true/>
	<key>com.apple.system-task-ports</key>
	<true/>
	<key>com.apple.system-task-ports.control</key>
	<true/>
	<key>com.apple.system-task-ports.token.control</key>
	<true/>
	<key>com.apple.private.thread-set-state</key>
	<true/>
	<key>com.apple.private.set-exception-port</key>
	<true/>
	<key>com.apple.security.cs.debugger</key>
	<true/>
	<key>com.apple.security.cs.allow-unsigned-executable-memory</key>
	<true/>

	<!-- ══════════ 系统前台与进程拉起特权（防止被系统冻结挂起） ══════════ -->
	<key>com.apple.springboard.launchapplications</key>
	<true/>
	<key>com.apple.frontboard.launchapplications</key>
	<true/>
	<key>com.apple.backboardd.launchapplications</key>
	<true/>
	<key>com.apple.springboard.appbackgroundstyle</key>
	<true/>
	<key>com.apple.runningboard.assertions.frontboard</key>
	<true/>
	<key>com.apple.runningboard.process-state</key>
	<true/>
	<key>com.apple.runningboard.launchprocess</key>
	<true/>

	<!-- ══════════ 免一切隐私权限弹窗（全系统直通） ══════════ -->
	<key>com.apple.private.tcc.allow</key>
	<array>
		<string>kTCCServiceAll</string>
		<string>kTCCServiceSystemPolicyAllFiles</string>
		<string>kTCCServiceLocation</string>
		<string>kTCCServiceMediaLibrary</string>
		<string>kTCCServiceMicrophone</string>
		<string>kTCCServicePhotos</string>
	</array>

	<!-- ══════════ 原版功能权限保留 ══════════ -->
	<key>com.apple.developer.healthkit</key>
	<true/>
	<key>com.apple.developer.healthkit.access</key>
	<array>
		<string>health-records</string>
	</array>
	<key>com.apple.developer.homekit</key>
	<true/>
	<key>com.apple.developer.icloud-container-identifiers</key>
	<array>
		<string>iCloud.com.openminis.app</string>
	</array>
	<key>com.apple.developer.icloud-services</key>
	<array>
		<string>CloudKit</string>
	</array>
	<key>com.apple.developer.nfc.readersession.formats</key>
	<array>
		<string>TAG</string>
		<string>PACE</string>
	</array>
	<key>com.apple.developer.ubiquity-container-identifiers</key>
	<array>
		<string>iCloud.com.openminis.app</string>
	</array>
	<key>com.apple.developer.weatherkit</key>
	<true/>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.openminis.app</string>
	</array>
</dict>
</plist>
