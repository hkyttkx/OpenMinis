<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- ══════════ 应用身份（CloudKit 必需） ══════════ -->
	<!-- 没有这两项，CKContainer(identifier:) 会直接报
	     "Trying to initialize a container without an application ID"，
	     导致 iCloud 同步、备份、迁移全部失效。
	     TrollStore 安装的 App 默认不带这两项，必须显式声明。 -->
	<key>application-identifier</key>
	<string>OPENMINIS01.com.openminis.app</string>
	<key>com.apple.developer.team-identifier</key>
	<string>OPENMINIS01</string>

	<!-- ══════════ 原版权限（保留） ══════════ -->
	<key>com.apple.developer.healthkit</key>
	<true/>
	<key>com.apple.developer.healthkit.access</key>
	<array>
		<string>health-records</string>
	</array>
	<key>com.apple.developer.homekit</key>
	<true/>
	<key>com.apple.developer.icloud-container-identifiers</key>
	<array>
		<string>iCloud.com.openminis.app</string>
	</array>
	<key>com.apple.developer.icloud-services</key>
	<array>
		<string>CloudKit</string>
	</array>
	<key>com.apple.developer.nfc.readersession.formats</key>
	<array>
		<string>TAG</string>
		<string>PACE</string>
	</array>
	<key>com.apple.developer.ubiquity-container-identifiers</key>
	<array>
		<string>iCloud.com.openminis.app</string>
	</array>
	<key>com.apple.developer.weatherkit</key>
	<true/>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.openminis.app</string>
	</array>

	<!-- ══════════ 逃逸沙盒（注入必需） ══════════ -->
	<!-- 动态注入依赖这一条，缺任何一项都会在第一步失败：
	       proc_pidpath        枚举其他进程、定位目标 PID
	       sandbox_extension   把 dylib 的读取/执行授权交给目标进程
	       写目标 App 目录      「严格复刻」模式需要
	     代价：WKWebView 的 WebContent 子进程可能拿不到容器扩展，
	     表现为内置浏览器加载失败。经权衡，注入优先。 -->
	<key>com.apple.private.security.no-sandbox</key>
	<true/>

	<!-- ══════════ 逆向工具扩展权限（TrollStore CoreTrust 信任） ══════════ -->
	<!-- 组合与 TrollStore 生态的 TrollApps 一致（已验证可列出全部 App / 读容器） -->
	<key>platform-application</key>
	<true/>
	<!-- 不声明 no-sandbox：逃逸沙盒会让 WKWebView 的 WebContent 子进程
	     拿不到本 App 容器的沙盒扩展，表现为「任何页面都打不开」——
	     含本地文件（本地文件同样经 WebContent 渲染）。
	     读其它 App 容器改用下面这几条沙盒例外，它们在保持沙盒的前提下
	     同样能枚举容器并读取 Bundle / Data。 -->
	<!-- LSApplicationWorkspace 枚举 App 所需 -->
	<key>com.apple.private.MobileContainerManager.allowed</key>
	<true/>
	<key>com.apple.private.security.container-manager</key>
	<true/>
	<key>com.apple.private.security.storage.AppDataContainers</key>
	<true/>
	<key>com.apple.private.security.storage.AppBundles</key>
	<true/>
	<!-- 绝对路径读写白名单（/ = 全盘） -->
	<key>com.apple.security.exception.files.absolute-path.read-write</key>
	<array>
		<string>/</string>
	</array>

	<!-- 调试 / 任务端口（砸壳与动态分析预留） -->
	<key>get-task-allow</key>
	<true/>
	<key>task_for_pid-allow</key>
	<true/>
	<!-- ══════════ Relaxin / Dopamine 官方内核与进程注入特权 ══════════ -->
	<key>com.apple.system-task-ports</key>
	<true/>
	<key>com.apple.system-task-ports.control</key>
	<true/>
	<key>com.apple.private.thread-set-state</key>
	<true/>
	<key>com.apple.private.set-exception-port</key>
	<true/>
	<key>com.apple.private.security.container-required</key>
	<false/>
	<!-- ══════════ 原版系统级进程启动与后台运行特权（防冻结） ══════════ -->
	<key>com.apple.springboard.launchapplications</key>
	<true/>
	<key>com.apple.frontboard.launchapplications</key>
	<true/>
	<key>com.apple.backboardd.launchapplications</key>
	<true/>
	<key>com.apple.springboard.appbackgroundstyle</key>
	<true/>
	<key>com.apple.runningboard.assertions.frontboard</key>
	<true/>
	<key>com.apple.runningboard.process-state</key>
	<true/>
	<key>com.apple.private.security.no-container</key>
	<true/>
	<key>com.apple.private.security.container-required</key>
	<false/>
	<key>com.apple.system-task-ports</key>
	<true/>
	<key>com.apple.system-task-ports.control</key>
	<true/>
	<key>com.apple.private.thread-set-state</key>
	<true/>
	<key>com.apple.private.set-exception-port</key>
	<true/>
</dict>
</plist>
